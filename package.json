{
  "name": "flowtrack-schedule",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:db:job-start": "node --import ./scripts/test-register.mjs --test test-db/early_job_start.test.ts",
    "test:db:demo-sessions": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/demo_sessions.test.ts test-db/demo_sessions_043.test.ts test-db/demo_sessions_044.test.ts test-db/demo_sessions_046.test.ts",
    "test:db": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/recurrence.test.ts",
    "test:db:schema": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/schema-audit.test.ts test-db/schema-export-diagnostic.test.ts",
    "test:db:billing": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/completed_job_billing.test.ts",
    "test:db:reminders": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/reminder_claims.test.ts test-db/reminder_occurrence_dedup.test.ts",
    "test:db:owner-security": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/owner_security_045.test.ts",
    "test:db:capacity": "node --experimental-test-module-mocks --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/capacity_fixes.test.ts",
    "test:db:scheduling": "node --experimental-test-module-mocks --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/scheduling_issues.test.ts",
    "test:db:seats": "node --experimental-test-module-mocks --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/employee_seats.test.ts",
    "test:db:invoices": "node --experimental-test-module-mocks --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/invoices_049.test.ts test-db/invoices_routes.test.ts",
    "test:db:messages": "node --import ./scripts/test-register.mjs --test --test-concurrency=1 test-db/messages_sent_subject.test.ts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.90.1",
