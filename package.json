    "@types/jsdom": "^28.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
